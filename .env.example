# ==========================================
# JurisMon Environment Configuration
# ==========================================
# Copy to .env and fill in real values. Never commit .env.

# Application
# Set APP_ENV=production on the VPS. In production the app refuses to start
# unless SECRET_KEY and ADMIN_PASSWORD_HASH are set.
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# JWT signing key. REQUIRED in production - there is no fallback.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of origins allowed to call the API.
# Must be the real site origin in production - do not use "*".
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Supabase Database
# SUPABASE_URL + SUPABASE_KEY are what the app actually uses.
# DATABASE_URL is reserved for future direct-Postgres access and is not read yet.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Crawler Settings
CRAWLER_CONCURRENCY=3
CRAWLER_DELAY_SECONDS=2
CRAWLER_USER_AGENT=JurisMonBot/1.0 (+https://jurismon.com/bot; research@jurismon.com)
HEADLESS_BROWSER=true

# Admin Authentication
# ADMIN_PASSWORD_HASH is a bcrypt hash, not a plaintext password.
# Generate with: python scripts/generate_admin_hash.py
# REQUIRED in production - admin login is disabled while it is empty.
ADMIN_EMAIL=admin@jurismon.com
ADMIN_PASSWORD_HASH=

# PayPal Subscriptions API
# PAYPAL_MODE selects the API host: 'sandbox' or 'live'
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Webhook signature verification fails closed - deliveries are rejected
# until PAYPAL_WEBHOOK_ID matches the webhook registered in PayPal.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PLAN_ID=P-XXXXXXXXXXXXXXX

# Stripe (Optional / Pluggable for future expansion)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
